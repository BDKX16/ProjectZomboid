{
  "schemaVersion": 1,
  "id": "regenerative_agriculture",
  "version": "${version}",
  "name": "Regenerative Agriculture",
  "description": "Seasons and climate by biome, greenhouses and grow rooms, living soil with crop rotation and companions, 18 crops, drying and curing, a microbrewery, mate, meals with effects and a farming manual with a route of milestones.",
  "authors": [
    "BDKX16"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/regenerative_agriculture/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "io.github.bdkx16.regenerativeagriculture.client.RegenerativeAgricultureDataGenerator"
    ],
    "client": [
      "io.github.bdkx16.regenerativeagriculture.client.RegenerativeAgricultureClient"
    ],
    "main": [
      "io.github.bdkx16.regenerativeagriculture.RegenerativeAgriculture"
    ]
  },
  "accessWidener": "regenerative_agriculture.classtweaker",
  "mixins": [
    "regenerative_agriculture.mixins.json",
    {
      "config": "regenerative_agriculture.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
